+static int mm_sae_invalid_helper_path(const char *path)
+{
+	const char *p;
+
+	if (!path || !path[0])
+		return 1;
+
+	for (p = path; *p; p++) {
+		if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' ||
+		    *p == '\'' || *p == '"' || *p == '\\' || *p == '`')
+			return 1;
+	}
+
+	return 0;
+}
+
+static int mm_sae_invalid_endpoint(const char *endpoint)
+{
+	const char *p;
+
+	if (!endpoint || !endpoint[0])
+		return 1;
+
+	for (p = endpoint; *p; p++) {
+		if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r' ||
+		    *p == '\'' || *p == '"' || *p == '\\' || *p == '`' ||
+		    *p == ';' || *p == '&' || *p == '|' || *p == '$' ||
+		    *p == '<' || *p == '>' || *p == '(' || *p == ')')
+			return 1;
+	}
+
+	return 0;
+}
+
+static int mm_sae_fetch_password_from_helper(struct hostapd_data *hapd,
+						    struct sta_info *sta,
+						    char **password)
+{
+	char cmd[256];
+	char line[128];
+	char *nl;
+	FILE *f;
+
+	if (!hapd || !sta || !password)
+		return -1;
+
+	if (mm_sae_invalid_helper_path(hapd->conf->mm_sae_password_helper))
+		return -1;
+
+	if (os_snprintf(cmd, sizeof(cmd), "%s %s " MACSTR,
+			hapd->conf->mm_sae_password_helper,
+			hapd->conf->iface,
+			MAC2STR(sta->addr)) >= (int) sizeof(cmd))
+		return -1;
+
+	f = popen(cmd, "r");
+	if (!f)
+		return -1;
+
+	if (!fgets(line, sizeof(line), f)) {
+		(void) pclose(f);
+		return -1;
+	}
+
+	(void) pclose(f);
+
+	nl = os_strchr(line, '\n');
+	if (nl)
+		*nl = '\0';
+	nl = os_strchr(line, '\r');
+	if (nl)
+		*nl = '\0';
+
+	if (!line[0])
+		return -1;
+
+	*password = os_strdup(line);
+	if (!*password)
+		return -1;
+
+	return 0;
+}
+
+static int mm_sae_fetch_password_from_url(struct hostapd_data *hapd,
+					 struct sta_info *sta,
+					 char **password)
+{
+	char cmd[640];
+	char ssid_hex[(2 * SSID_MAX_LEN) + 1];
+	char line[128];
+	char *nl;
+	FILE *f;
+	int rc;
+
+	if (!hapd || !sta || !password)
+		return -1;
+
+	if (mm_sae_invalid_endpoint(hapd->conf->mm_sae_password_url))
+		return -1;
+
+	wpa_snprintf_hex(ssid_hex, sizeof(ssid_hex),
+			 hapd->conf->ssid.ssid, hapd->conf->ssid.ssid_len);
+
+	if (os_snprintf(cmd, sizeof(cmd),
+			"uclient-fetch -qO- --timeout=2 -- '%s?mac=" MACSTR "&self_mac=" MACSTR "&ssid=%s'",
+			hapd->conf->mm_sae_password_url,
+			MAC2STR(sta->addr),
+			MAC2STR(hapd->own_addr),
+			ssid_hex) >= (int) sizeof(cmd))
+		return -1;
+
+	f = popen(cmd, "r");
+	if (!f)
+		return -1;
+
+	if (!fgets(line, sizeof(line), f)) {
+		(void) pclose(f);
+		return -1;
+	}
+
+	rc = pclose(f);
+	if (rc != 0)
+		return -1;
+
+	nl = os_strchr(line, '\n');
+	if (nl)
+		*nl = '\0';
+	nl = os_strchr(line, '\r');
+	if (nl)
+		*nl = '\0';
+
+	if (!line[0])
+		return -1;
+
+	*password = os_strdup(line);
+	if (!*password)
+		return -1;
+
+	return 0;
+}
