+
+static const char * mm_sae_custom_role_txt(enum mm_sae_custom_role role)
+{
+	return role == MM_SAE_CUSTOM_ROLE_SERVER ? "server" : "client";
+}
+
+
+static void mm_sae_custom_derive_local_pub(struct sae_data *sae,
+					   enum mm_sae_custom_role role,
+					   const u8 *own_addr,
+					   const u8 *peer_addr)
+{
+	u8 scalar_bin[SAE_MAX_PRIME_LEN];
+	const u8 *addr[6];
+	size_t len[6];
+	size_t scalar_len;
+	const u8 *pair_key;
+	const char *role_txt;
+
+	scalar_len = 0;
+	pair_key = (const u8 *) "MM_DUMMY_PSK_PAIR_V1";
+	role_txt = mm_sae_custom_role_txt(role);
+	os_memset(scalar_bin, 0, sizeof(scalar_bin));
+
+	if (sae->tmp && sae->tmp->own_commit_scalar) {
+		scalar_len = sae->tmp->prime_len;
+		if (scalar_len > sizeof(scalar_bin))
+			scalar_len = sizeof(scalar_bin);
+		if (crypto_bignum_to_bin(sae->tmp->own_commit_scalar, scalar_bin,
+					 sizeof(scalar_bin), scalar_len) < 0)
+			scalar_len = 0;
+	}
+
+	addr[0] = pair_key;
+	len[0] = os_strlen((const char *) pair_key);
+	addr[1] = (const u8 *) role_txt;
+	len[1] = os_strlen(role_txt);
+	addr[2] = own_addr;
+	len[2] = own_addr ? ETH_ALEN : 0;
+	addr[3] = peer_addr;
+	len[3] = peer_addr ? ETH_ALEN : 0;
+	addr[4] = scalar_bin;
+	len[4] = scalar_len;
+	addr[5] = (const u8 *) "MM_SAE_DUMMY_LOCAL_PUB";
+	len[5] = 22;
+
+	if (sha256_vector(6, addr, len, sae->mm_custom_local_pub) < 0)
+		os_memset(sae->mm_custom_local_pub, 0,
+			  sizeof(sae->mm_custom_local_pub));
+}
+
+
+static void mm_sae_custom_try_derive_aes_key(struct sae_data *sae,
+					      enum mm_sae_custom_role role)
+{
+	const u8 *addr[3];
+	size_t len[3];
+	const u8 *first;
+	const u8 *second;
+
+	(void) mm_sae_custom_role_txt(role);
+	first = sae->mm_custom_local_pub;
+	second = sae->mm_custom_peer_pub;
+
+	if (os_memcmp(first, second, MM_SAE_CUSTOM_KEY_LEN) > 0) {
+		first = sae->mm_custom_peer_pub;
+		second = sae->mm_custom_local_pub;
+	}
+
+	addr[0] = (const u8 *) "MM_SAE_DUMMY_DH_AES_V1";
+	len[0] = 21;
+	addr[1] = first;
+	len[1] = MM_SAE_CUSTOM_KEY_LEN;
+	addr[2] = second;
+	len[2] = MM_SAE_CUSTOM_KEY_LEN;
+
+	if (sha256_vector(3, addr, len, sae->mm_custom_aes_key) < 0) {
+		sae->mm_custom_key_ready = 0;
+		os_memset(sae->mm_custom_aes_key, 0, sizeof(sae->mm_custom_aes_key));
+		return;
+	}
+
+	sae->mm_custom_key_ready = 1;
+	wpa_printf(MSG_DEBUG, "SAE-CUSTOM: dummy shared AES key is ready");
+}
+
+
+void mm_sae_custom_commit_tx(struct sae_data *sae, enum mm_sae_custom_role role,
+			     const u8 *own_addr, const u8 *peer_addr)
+{
+	if (!sae)
+		return;
+
+	mm_sae_custom_derive_local_pub(sae, role, own_addr, peer_addr);
+	wpa_hexdump(MSG_DEBUG, "SAE-CUSTOM: local pseudo public key",
+		    sae->mm_custom_local_pub, sizeof(sae->mm_custom_local_pub));
+}
+
+
+void mm_sae_custom_commit_rx(struct sae_data *sae, enum mm_sae_custom_role role,
+			     const u8 *own_addr, const u8 *peer_addr,
+			     const u8 *commit_frame, size_t commit_len)
+{
+	const u8 *addr[2];
+	size_t len[2];
+
+	if (!sae || !commit_frame || !commit_len)
+		return;
+
+	if (sae->mm_custom_local_pub[0] == 0)
+		mm_sae_custom_derive_local_pub(sae, role, own_addr, peer_addr);
+
+	addr[0] = commit_frame;
+	len[0] = commit_len;
+	addr[1] = (const u8 *) "MM_SAE_DUMMY_PEER_PUB";
+	len[1] = 21;
+	if (sha256_vector(2, addr, len, sae->mm_custom_peer_pub) < 0) {
+		os_memset(sae->mm_custom_peer_pub, 0,
+			  sizeof(sae->mm_custom_peer_pub));
+		return;
+	}
+
+	wpa_hexdump(MSG_DEBUG, "SAE-CUSTOM: peer pseudo public key",
+		    sae->mm_custom_peer_pub, sizeof(sae->mm_custom_peer_pub));
+	mm_sae_custom_try_derive_aes_key(sae, role);
+}
